{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 2
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["skill", "plugin", "directory"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "includePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requireFormat": {
            "type": "boolean"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "track": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "branch": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["branch"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["tag"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tagPrefix": {
                    "type": "string"
                  },
                  "prerelease": {
                    "type": "boolean"
                  }
                },
                "required": ["version"],
                "additionalProperties": false
              }
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "destination": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["path", "destination"],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": ["source", "commit", "kind", "path", "destination"],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": ["schemaVersion", "sources", "artifacts"],
  "additionalProperties": false
}
